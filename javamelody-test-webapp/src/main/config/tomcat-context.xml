<?xml version="1.0" encoding="UTF-8" ?>
<Context>
	<Parameter name='javamelody.resolution-seconds' value='60'
		override='false' />
	<Parameter name='javamelody.admin-emails'
		value='x@y.z' override='false' />
	<Parameter name='javamelody.mail-session'
		value='mail/Session' override='false' />
	<Parameter name='javamelody.mail-periods'
		value='day,week,month' override='false' />

	<!-- seuils comme indiques dans la spec technique -->
	<Parameter name='javamelody.warning-threshold-millis'
		value='2000' override='false' />
	<Parameter name='javamelody.severe-threshold-millis'
		value='5000' override='false' />
	<Resource name="jdbc/TestDB" auth="Container"
		type="javax.sql.DataSource" defaultAutoCommit="false" maxTotal="100"
		maxIdle="30" maxWaitMillis="10000" username="sa" password=""
		driverClassName="org.h2.Driver" url="jdbc:h2:c:/Applis/h2/test-webapp" />
	<Resource name="jdbc/TestDB2" auth="Container"
		type="javax.sql.DataSource" defaultAutoCommit="false" maxTotal="100"
		maxIdle="30" maxWaitMillis="10000" username="sa" password=""
		driverClassName="org.h2.Driver" url="jdbc:h2:c:/Applis/h2/test-webapp2" />
